---
import { existsSync } from 'node:fs';
import { join } from 'node:path';

type Props = {
	class?: string;
};

const { class: className } = Astro.props;
const hasTransparentPortrait = existsSync(join(process.cwd(), 'public', 'images', 'profile-cutout.png'));
---

{
	hasTransparentPortrait && (
		<figure class:list={['profile-cutout', 'profile-cutout--transparent', className]}>
			<img src="/images/profile-cutout.png" alt="Portrait of Maximos Skandalis" loading="lazy" />
		</figure>
	)
}