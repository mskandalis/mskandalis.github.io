---
import { ArrowUpRight, Copy } from '@lucide/astro';
import { bibtexEntries } from '../data/bibtex';
import {
	coAuthoredPublications,
	publications,
	publicOutreach,
	researchDirections,
	researchPresentations,
	researchProfiles,
	researchRepositories,
} from '../data/academic';
import AcademicPage from '../layouts/AcademicPage.astro';
---

<AcademicPage
	currentPath="/research/"
	title="Research"
	description="Research, publications, and talks by Maximos Skandalis on neurosymbolic natural language inference and contradiction detection."
	eyebrow="02 / Research"
	heading="Large language models &"
	emphasis="machine reasoning."
	intro="Research spanning large language models (LLMs), neurosymbolic AI, explainable AI (XAI), multilingual AI, machine reasoning, and AI applications."
>
	<aside slot="hero-aside" class="research-profile-rail" aria-label="Research profiles">
		<div class="research-profile-label">Research profiles</div>
		<div class="research-profile-list">
			{
				researchProfiles.map((profile) => (
					<a class="research-profile-card" href={profile.href} target="_blank" rel="noreferrer">
						<span class="research-profile-logo">
							<img src={profile.logoSrc} alt={profile.logoAlt} loading="lazy" />
						</span>
						<span>{profile.label}</span>
						<ArrowUpRight aria-hidden="true" size={15} strokeWidth={1.8} />
					</a>
				))
			}
		</div>
		<div class="research-profile-label">Repositories</div>
		<div class="research-profile-list">
			{
				researchRepositories.map((repository) => (
					<a class="research-profile-card" href={repository.href} target="_blank" rel="noreferrer">
						<span class="research-profile-logo">
							<img src={repository.logoSrc} alt={repository.logoAlt} loading="lazy" />
						</span>
						<span>{repository.label}</span>
						<ArrowUpRight aria-hidden="true" size={15} strokeWidth={1.8} />
					</a>
				))
			}
		</div>
	</aside>

	<section class="page-section" id="directions" aria-labelledby="directions-heading">
		<div class="page-section-label"><span>Directions</span></div>
		<div class="page-section-content">
			<h2 class="page-section-title" id="directions-heading">Current research directions</h2>
			<div class="academic-list">
				{
					researchDirections.map((direction) => (
						<article class="academic-item">
							<div class="academic-meta"><span>{direction.index}</span><span>{direction.status}</span></div>
							<div>
								<h3>{direction.title}</h3>
								<p>{direction.description}</p>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="page-section" id="proceedings" aria-labelledby="publications-heading">
		<div class="page-section-label"><span>Proceedings</span></div>
		<div class="page-section-content">
			<h2 class="page-section-title" id="publications-heading">Conference papers and <em>proceedings.</em></h2>
			<div class="academic-list">
				{
					publications.map((publication) => (
						<article class="academic-item academic-item--publication">
							<div class="academic-meta"><span>{publication.year}</span><span>{publication.role}</span></div>
							<div>
								<h3>{publication.title}</h3>
								<p class="academic-authors">{publication.authors}</p>
								<p>{publication.venue}</p>
							</div>
							<div class="academic-actions">
								<a class="academic-link" href={publication.href} target="_blank" rel="noreferrer">{publication.linkLabel}</a>
								{
									publication.bibtexKey && (
										<button
											class="bibtex-copy"
											type="button"
											data-bibtex-key={publication.bibtexKey}
											title="Copy BibTeX entry"
											aria-label={`Copy BibTeX entry for ${publication.title}`}
										>
											<Copy aria-hidden="true" size={13} strokeWidth={1.8} />
											<span>BibTeX</span>
										</button>
									)
								}
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="page-section" id="co-authored" aria-labelledby="coauthored-heading">
		<div class="page-section-label"><span>Co-authored</span></div>
		<div class="page-section-content">
			<h2 class="page-section-title" id="coauthored-heading">Other collaborative <em>publications.</em></h2>
			<div class="academic-list">
				{
					coAuthoredPublications.map((publication) => (
						<article class="academic-item academic-item--publication">
							<div class="academic-meta"><span>{publication.year}</span><span>{publication.role}</span></div>
							<div>
								<h3>{publication.title}</h3>
								<p class="academic-authors">{publication.authors}</p>
								<p>{publication.venue}</p>
							</div>
							<div class="academic-actions">
								<a class="academic-link" href={publication.href} target="_blank" rel="noreferrer">{publication.linkLabel}</a>
								{
									publication.bibtexKey && (
										<button
											class="bibtex-copy"
											type="button"
											data-bibtex-key={publication.bibtexKey}
											title="Copy BibTeX entry"
											aria-label={`Copy BibTeX entry for ${publication.title}`}
										>
											<Copy aria-hidden="true" size={13} strokeWidth={1.8} />
											<span>BibTeX</span>
										</button>
									)
								}
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="page-section" id="presentations" aria-labelledby="presentations-heading">
		<div class="page-section-label"><span>Presentations</span></div>
		<div class="page-section-content">
			<h2 class="page-section-title" id="presentations-heading">Oral and poster <em>presentations.</em></h2>
			<div class="academic-list">
				{
					researchPresentations.map((presentation) => (
						<article class="academic-item">
							<div class="academic-meta"><span>{presentation.date}</span><span>{presentation.format}</span></div>
							<div>
								<h3>{presentation.title}</h3>
								<p>{presentation.detail}</p>
							</div>
							{
								(presentation.href || presentation.bibtexKey) && (
									<div class="academic-actions">
										{presentation.href && <a class="academic-link" href={presentation.href} target="_blank" rel="noreferrer">{presentation.linkLabel}</a>}
										{
											presentation.bibtexKey && (
												<button
													class="bibtex-copy"
													type="button"
													data-bibtex-key={presentation.bibtexKey}
													title="Copy BibTeX entry"
													aria-label={`Copy BibTeX entry for ${presentation.title}`}
												>
													<Copy aria-hidden="true" size={13} strokeWidth={1.8} />
													<span>BibTeX</span>
												</button>
											)
										}
									</div>
								)
							}
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="page-section" id="outreach" aria-labelledby="outreach-heading">
		<div class="page-section-label"><span>Public outreach</span></div>
		<div class="page-section-content">
			<h2 class="page-section-title" id="outreach-heading">Public <em>engagement.</em></h2>
			<div class="academic-list">
				{
					publicOutreach.map((item) => (
						<article class="academic-item">
							<div class="academic-meta"><span>{item.date}</span><span>Outreach</span></div>
							<div>
								<h3>{item.title}</h3>
								<p>{item.detail}</p>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<script define:vars={{ bibtexEntries }}>
		const copyFallback = (value) => {
			const textArea = document.createElement('textarea');
			textArea.value = value;
			textArea.setAttribute('readonly', '');
			textArea.style.position = 'fixed';
			textArea.style.opacity = '0';
			document.body.appendChild(textArea);
			textArea.select();
			document.execCommand('copy');
			textArea.remove();
		};

		document.querySelectorAll('.bibtex-copy').forEach((button) => {
			button.addEventListener('click', async () => {
				const key = button.dataset.bibtexKey;
				const entry = key ? bibtexEntries[key] : undefined;
				if (!entry) return;

				try {
					await navigator.clipboard.writeText(entry);
				} catch {
					copyFallback(entry);
				}

				button.dataset.copied = 'true';
				button.title = 'BibTeX entry copied';
				window.setTimeout(() => {
					delete button.dataset.copied;
					button.title = 'Copy BibTeX entry';
				}, 1600);
			});
		});
	</script>
</AcademicPage>